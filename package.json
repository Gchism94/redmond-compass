{
  "name": "redmond-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Redmond Compass \u2014 mobile-first installable PWA. Hyperlocal directory + community hub for Redmond, OR.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test:sync && npm run test:gcal && npm run test:categories && npm run test:scale && npm run test:errors && npm run test:auth-ui && npm run test:delete-account && npm run test:edit-listing && npm run test:guest-save && npm run test:classes && npm run test:notices",
    "test:sync": "node scripts/sync-sheet-test.mjs",
    "test:gcal": "node scripts/gcal-sync-test.mjs",
    "test:categories": "node scripts/category-vocab-test.mjs",
    "test:scale": "node scripts/saved-list-scale-test.mjs",
    "test:errors": "node scripts/error-state-test.mjs",
    "test:auth-ui": "node scripts/auth-ui-test.mjs",
    "test:delete-account": "node scripts/delete-account-test.mjs",
    "test:edit-listing": "node scripts/edit-listing-category-test.mjs",
    "test:rls": "node scripts/rls-test.mjs",
    "check:bundle": "node scripts/check-prod-bundle.mjs",
    "check:base44": "node scripts/check-no-base44.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "test:guest-save": "node scripts/guest-save-test.mjs",
    "test:classes": "node scripts/business-classes-test.mjs",
    "test:notices": "node scripts/community-notices-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
